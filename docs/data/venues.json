 "gates": {
  "main": {
   "label_en": "Restaurants (main gate)",
   "label_zh": "正餐（主闸门）",
   "min_rating": 4.7,
   "min_reviews": 200,
   "rationale_en": "The baseline. Tuned for 'proper restaurants'; it breaks in every other category, which is why the gates below exist.",
   "rationale_zh": "基准闸门，针对「正经餐厅」。套到别的品类上会立刻失效，所以下面每类各立一条。"
  },
  "budget": {
   "label_en": "Budget tier",
   "label_zh": "平价档",
   "min_rating": 4.5,
   "min_reviews": 1000,
   "rationale_en": "Rating bar drops 0.2; sample bar rises 5x as compensation. Better 'lots of people said 4.5' than 'a few said 4.8'.",
   "rationale_zh": "评分降 0.2，样本门槛提高 5 倍作补偿——宁要「很多人打 4.5」，不要「少数人打 4.8」。"
  },
  "coffee": {
   "label_en": "Coffee",
   "label_zh": "咖啡",
   "min_rating": 4.7,
   "min_reviews": 200,
   "rationale_en": "Deliberately NOT loosened. Coffee ratings run high everywhere; the sample bar is what filters out 'fifteen people gave it 5'.",
   "rationale_zh": "刻意不放宽。咖啡店评分虚高，靠样本量挡住「十几个人打 5 分」。"
  },
  "drinks": {
   "label_en": "Bubble tea and drinks",
   "label_zh": "奶茶饮品",
   "min_rating": 4.5,
   "min_reviews": 200,
   "rationale_en": "Ratings are inflated as with coffee, but samples are far smaller, so the rating bar drops to 4.5 while the sample bar stays at 200. Looser than coffee (4.7), tighter than the community-cuisine gate (4.3).",
   "rationale_zh": "与咖啡同样存在评分虚高，但样本量小得多，因此评分门槛降到 4.5、样本门槛保持 200。比咖啡（4.7）宽，比族裔餐饮闸门（4.3）严。"
  },
  "community_cuisine": {
   "label_en": "Community cuisines (Chinese, Vietnamese, East African...)",
   "label_zh": "族裔餐饮（华／越／东非等）",
   "min_rating": 4.3,
   "min_reviews": 150,
   "rationale_en": "Customers are mostly from that community, so English-language reviews are structurally scarcer regardless of quality.",
   "rationale_zh": "顾客以该社群为主，英文点评天然更少，与好不好吃无关。"
  },
  "cuisine": {
   "label_en": "Other cuisines (Indian, Italian, French, Greek, Middle Eastern...)",
   "label_zh": "各菜系",
   "min_rating": 4.5,
   "min_reviews": 300,
   "rationale_en": "Trading rating width for sample size.",
   "rationale_zh": "用样本量换评分宽度。"
  },
  "club": {
